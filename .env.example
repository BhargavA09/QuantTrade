# =============================================================================
# QuantTrade Pro - Secure Environment Template
# =============================================================================
# CRITICAL CYBERSECURITY NOTICE:
# Never commit real API keys, production tokens, or private secrets to version control.
# All client-side keys should be securely saved in the AES-256-GCM Zero-Knowledge Key Vault.
# Server-side proxy keys should be supplied via container secrets or secret managers.
# =============================================================================

# Server Port & Runtime Environment
PORT=3000
NODE_ENV=production

# Server-Side Upstream API Proxy Keys (Optional - Fallbacks to open/simulated feeds if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here
# FINNHUB_API_KEY=your_finnhub_key_here
# POLYGON_API_KEY=your_polygon_key_here
# FMP_API_KEY=your_fmp_key_here

# Institutional Vault Configuration
VAULT_AUTO_LOCK_MINUTES=5
VAULT_PBKDF2_ROUNDS=100000
